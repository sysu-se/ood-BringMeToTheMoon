{
	"name": "sudoku",
	"version": "1.0.0",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "rollup -c --environment NODE_ENV:production",
		"postbuild": "node scripts/postbuild.js",
		"predev": "rimraf dist",
		"dev": "rollup -c -w",
		"start": "sirv dist",
		"test": "vitest run",
		"test:contract": "vitest run tests/hw1/01-contract.test.js",
		"test:sudoku": "vitest run tests/hw1/02-sudoku-basic.test.js",
		"test:clone": "vitest run tests/hw1/03-clone.test.js",
		"test:game": "vitest run tests/hw1/04-game-undo-redo.test.js",
		"test:serialization": "vitest run tests/hw1/05-serialization.test.js"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "25.0.7",
		"@rollup/plugin-node-resolve": "15.2.3",
		"@tailwindcss/forms": "0.4.3",
		"autoprefixer": "10.4.19",
		"inline-critical": "6.0.1",
		"postcss": "8.4.38",
		"postcss-clean": "1.1.0",
		"postcss-import": "15.1.0",
		"postcss-load-config": "4.0.2",
		"reaver": "2.0.0",
		"rimraf": "5.0.7",
		"rollup": "4.17.2",
		"rollup-plugin-copy": "3.5.0",
		"rollup-plugin-css-only": "4.5.5",
		"rollup-plugin-livereload": "2.0.5",
		"rollup-plugin-svelte": "7.1.6",
		"rollup-plugin-terser": "7.0.2",
		"svelte": "3.59.2",
		"svelte-preprocess": "5.1.3",
		"vitest": "1.4.0"
	},
	"dependencies": {
		"@mattflow/sudoku-solver": "2.2.0",
		"fake-sudoku-puzzle-generator": "1.2.1",
		"sirv-cli": "2.0.2",
		"tailwindcss": "2.2.19"
	}
}
